<Window x:Class="GrpcViewport.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:GrpcViewport.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="Tools" IsEnabled="False">
                <Button Content="Add lines"     Click="AddLines_Click" />
                <Button Content="Add points"    Click="AddPoints_Click" />
                <Button Content="Add big cloud" Click="AddBigCloud_Click" />
                <Button Content="Add boxes"     Click="AddBoxes_Click" />
                <Button Content="Add segment"   Click="AddSegment_Click" />
                <Separator />
                <Button Content="Remove last"   Click="RemoveLast_Click" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="starting server…" />
        </StatusBar>

        <!-- Last child of a DockPanel fills the rest -->
        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
